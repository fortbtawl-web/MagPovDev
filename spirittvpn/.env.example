# ===== Telegram =====
# Токен от @BotFather. Никогда не коммить реальный токен.
BOT_TOKEN=1234567890:replace_me
# Роли из окружения (узнать свой ID: @userinfobot). Остальных сотрудников (поддержка, тех. специалист)
# владелец назначает в админ-панели Mini App.
OWNER_IDS=123456789
ADMIN_IDS=
# development | production | test
APP_ENV=production
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Europe/Moscow

# ===== База данных =====
# В docker-compose DATABASE_URL собирается автоматически из POSTGRES_*.
# Для локального запуска без Docker можно использовать SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./data/spirittvpn.db
POSTGRES_DB=spirittvpn
POSTGRES_USER=spirittvpn
POSTGRES_PASSWORD=change_me_to_a_long_random_password
BACKUP_RETENTION_DAYS=14
# REDIS_URL=redis://localhost:6379/0   # FSM-хранилище; без него — в памяти

# ===== Документы =====
# Меняй при обновлении текстов документов — пользователи примут их заново.
LEGAL_DOCS_VERSION=2024-08-12

# ===== Оплата =====
# none — оплата выключена; telegram — Telegram Payments; test — ТОЛЬКО для разработки
PAYMENT_PROVIDER=none
# RUB + PAYMENT_PROVIDER_TOKEN из BotFather → Payments; или XTR = Telegram Stars (токен не нужен, цены в звёздах)
PAYMENT_CURRENCY=RUB
PAYMENT_PROVIDER_TOKEN=
# Для PAYMENT_PROVIDER=test (запрещено при APP_ENV=production)
PAYMENT_TEST_SECRET=
ORDER_TTL_HOURS=24

# Каталог тарифов создаётся один раз при первом запуске (цены в копейках; для XTR — в звёздах).
# Дальше цены, сроки и лимиты устройств меняются в админ-панели без перевыпуска фронтенда.
PLAN_SOLO30_PRICE=10000
PLAN_DUO30_PRICE=20000
PLAN_Q3_PRICE=25000
PLAN_Q3_DEVICES=2
PLAN_Y1_PRICE=115000
PLAN_Y1_DEVICES=3
PLAN_LIFE_PRICE=500000
PLAN_LIFE_DEVICES=3
TRIAL_DEVICE_LIMIT=1

# ===== VPN =====
# none — инфраструктура не подключена (бот честно пишет «серверы готовятся к запуску»)
# mock — ТОЛЬКО разработка: тестовые ссылки с пометкой «не рабочий VPN» (запрещено при APP_ENV=production)
# remnawave — панель Remnawave (рекомендуется); marzban — панель Marzban
VPN_PROVIDER=none
VPN_TIMEOUT_SECONDS=10
VPN_RETRY_ATTEMPTS=3
VPN_USERNAME_PREFIX=sp
REMNAWAVE_URL=
# API-токен: Remnawave → Settings → API Tokens. Хранится только здесь.
REMNAWAVE_TOKEN=
# UUID внутренних сквадов (Internal Squads), которые получают новые клиенты, через запятую
REMNAWAVE_SQUADS=
# Лимит HWID на одно устройство-клиента (0 — не задавать). Работает, если HWID включён в панели и клиент его передаёт.
REMNAWAVE_HWID_LIMIT=1
# true — если бот ходит в панель по внутренней сети по HTTP (добавляет X-Forwarded-* заголовки)
REMNAWAVE_LOCAL=false
MARZBAN_URL=
MARZBAN_USERNAME=
MARZBAN_PASSWORD=
MARZBAN_PROXIES=vless

# ===== HTTP (webhook оплаты, health) =====
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Публичный HTTPS-адрес сервера. Mini App открывается по PUBLIC_BASE_URL/app/ (Telegram требует https).
# Без него бот работает в резервном режиме на обычных сообщениях.
PUBLIC_BASE_URL=
# WEBAPP_URL=https://vpn.example.com/app/   # если Mini App на другом домене
INIT_DATA_TTL_SECONDS=86400
API_RATE_PER_MINUTE=120

# ===== Фоновые задачи / антифлуд =====
JOB_INTERVAL_SECONDS=300
RECONCILE_INTERVAL_SECONDS=3600
FINAL_NOTICE_HOURS=3
THROTTLE_SECONDS=0.4
BROADCAST_RATE_PER_SECOND=20
