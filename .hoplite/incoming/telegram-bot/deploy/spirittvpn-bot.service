[Unit]
Description=SpirittVPN Telegram bot
After=network-online.target postgresql.service spirittvpn-api.service
Wants=network-online.target

[Service]
User=spiritt
WorkingDirectory=/opt/spirittvpn/SpirittVPN
ExecStart=/opt/spirittvpn/SpirittVPN/.venv/bin/python -m bot
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
