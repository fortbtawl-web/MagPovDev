# ============================================================
# SpirittVPN — пример конфигурации. Скопируйте в .env и заполните.
# Никогда не коммитьте .env и не отправляйте его третьим лицам.
# ============================================================

# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# Необязательный файл лога с ротацией (5 МБ × 3), например logs/spirittvpn.log. Пусто — только консоль.
LOG_FILE=

# --- Запуск через run.py (PY_FILE=run.py на хостинге) ---
# all — API и бот; bot — только бот; api — только API
RUN_COMPONENTS=all
# true — применять новые миграции при старте (пустая база создаётся всегда). Перед этим сделайте бэкап.
AUTO_MIGRATE=false

# --- Telegram ---
# Токен от @BotFather. Храните только в .env.
BOT_TOKEN=
# Главный администратор: числовой Telegram ID (НЕ username). Узнать: /whoami в боте или @userinfobot.
# Если не задан, бот при запуске пишет в лог одноразовую команду /setup <код> для назначения владельца.
OWNER_TELEGRAM_ID=
# Дополнительные администраторы через запятую (числа). Их также можно назначать в админ-панели (только владелец).
ADMIN_IDS=
# Часовой пояс для ввода дат и календарных расчётов (хранение всегда в UTC)
DISPLAY_TIMEZONE=Europe/Moscow
# Публичный HTTPS-адрес Mini App (обычно = PUBLIC_BASE_URL, т.к. backend сам раздаёт frontend)
WEBAPP_URL=
# Ссылка на поддержку, например https://t.me/spiritt_support
SUPPORT_URL=

# --- Обязательные документы (экран принятия при первом /start) ---
# Увеличьте TERMS_VERSION при изменении документов — все пользователи примут их заново.
TERMS_VERSION=2025-08-12
PRIVACY_URL=https://telegra.ph/POLITIKA-KONFIDENCIALNOSTI-08-12-99
TERMS_URL=https://telegra.ph/PUBLICHNAYA-OFERTA-08-12-15

# --- Обязательная подписка на канал ---
# Бот должен быть АДМИНИСТРАТОРОМ канала, иначе Telegram не отдаёт статус участников.
CHANNEL_CHECK_ENABLED=true
REQUIRED_CHANNEL=@spirit_vpn_news
REQUIRED_CHANNEL_URL=https://t.me/spirit_vpn_news
# Сколько секунд помнить положительный результат проверки (0 — проверять каждый раз)
CHANNEL_CACHE_SECONDS=300

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://spiritt:CHANGE_ME@localhost:5432/spiritt
DB_POOL_SIZE=10

# --- HTTP API / Mini App backend ---
API_HOST=0.0.0.0
API_PORT=8080
# Публичный HTTPS-адрес backend (для webhook ЮKassa), например https://vpn.example.com
PUBLIC_BASE_URL=
# Случайная строка >= 32 символов: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_MINUTES=60
ADMIN_SESSION_TTL_MINUTES=120
INITDATA_MAX_AGE_SECONDS=86400
# Разрешённые CORS-источники через запятую (нужно, только если frontend на другом домене)
CORS_ORIGINS=
SERVE_FRONTEND=true
FRONTEND_DIST=frontend/dist
# Фоновые задачи (истечение подписок, опрос платежей, повтор VPN-операций, проверка нод)
RUN_WORKER=true
WORKER_INTERVAL_SECONDS=60
# true, если backend стоит за nginx/прокси (для корректного IP в проверке webhook ЮKassa)
TRUST_FORWARDED_FOR=false

# --- Платежи ---
# yookassa | none   (none — продажи честно отключены)
PAYMENT_PROVIDER=none
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты (например https://t.me/ВАШ_БОТ)
YOOKASSA_RETURN_URL=
YOOKASSA_VERIFY_IP=true
# Чек 54-ФЗ (если в магазине включена фискализация)
YOOKASSA_RECEIPT_ENABLED=false
YOOKASSA_RECEIPT_EMAIL=
YOOKASSA_VAT_CODE=1

# --- VPN: ноды H1//VLESS ---
# Формат: код|Название|Код страны|URL API (с /api);  ноды разделяются ";"
# Для бота за пределами РФ используйте адрес direct-<нода> (панель → «API-доступ» → «Запросы с серверов за рубежом»).
# Адреса ниже проверены на реальных панелях SpirittVPN (h1vless 2.7.3), секретов в них нет.
VPN_NODES=de|Германия|DE|http://direct-de23.h1cloud.net:25569/api;fi|Финляндия|FI|http://direct-fi8.h1cloud.net:25286/api;us|США|US|http://direct-us7.h1cloud.net:25186/api;pl|Польша|PL|http://direct-pl3.h1cloud.net:25310/api;ru|Россия|RU|http://direct-msk2.h1cloud.net:25256/api
# API-токен каждой панели: панель → «API-доступ» → «Получить API-токен» (не ключ кабинета h1_…)
VPN_NODE_DE_TOKEN=
VPN_NODE_FI_TOKEN=
VPN_NODE_US_TOKEN=
VPN_NODE_PL_TOKEN=
VPN_NODE_RU_TOKEN=
# false — только если нода использует самоподписанный сертификат
VPN_VERIFY_TLS=true
VPN_TIMEOUT_SECONDS=20
# true — считать ноду недоступной, если её публичные VPN-порты не открываются с сервера бота (по умолчанию только предупреждение)
VPN_BLOCK_ON_DEAD_ENDPOINTS=false
# Виртуальная локация «Все локации (автовыбор)»: одна подписка со всеми нодами, у которых задан токен.
# Хаб — нода-главная федерации (Германия); токены остальных нод нужны только для списка локаций.
# --- Telegram Mini App (по умолчанию выключен: нужен публичный HTTPS-адрес) ---
# Свой домен: WEBAPP_URL=https://app.example.com (reverse proxy -> порт API 8080).
# Без домена: WEBAPP_TUNNEL=cloudflared — бот сам поднимет временный HTTPS-адрес (меняется при каждом запуске).
WEBAPP_TUNNEL=
VPN_ALL_ENABLED=true
VPN_ALL_HUB=de
